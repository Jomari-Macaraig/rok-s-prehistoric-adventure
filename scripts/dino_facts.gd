static func for_id(id: String) -> Dictionary:
	return FACTS.get(id, {})


## The facts as a short readable block for a card.
static func text(id: String) -> String:
	var f := for_id(id)
	if f.is_empty():
		return ""
	return "%s\nWhen: %s\nWhere: %s\nSize: %s\nFood: %s" % [f.what, f.era, f.where, f.size, f.ate]
